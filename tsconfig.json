{
  // Type checking only: Vite, Vitest and esbuild strip the types when they run or bundle
  // the code, and Node 24 strips them itself for server files, so nothing is emitted.
  // `npm run typecheck` (vue-tsc) checks every .ts file and <script lang="ts"> component. The
  // only JavaScript is the vendored HiGHS build, typed by vendor/highs.d.cts. See "TypeScript"
  // in AGENTS.md.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only syntax that can be erased (no enums, namespaces or parameter properties), so
    // Node can run a .ts file as written, and imports name the .ts file itself.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["public/**/*", "tests/**/*", "*.ts"],
  "exclude": ["node_modules", "dist", "public/icons"]
}
