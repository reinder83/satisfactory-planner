# Local access by default. Use 0.0.0.0 to serve other devices on your network.
BIND_ADDRESS=127.0.0.1
PORT=8080
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
# Set a password before exposing the planner beyond your own machine.
APP_USER=pioneer
APP_PASSWORD=

# Set true behind an HTTPS reverse proxy when using accounts.
COOKIE_SECURE=false
