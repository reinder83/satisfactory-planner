{
  "name": "satisfactory-planner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted Satisfactory build and storage planner",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "test": "node --test tests/*.test.ts && vitest run",
    "check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "build": "node build.ts"
  },
  "devDependencies": {
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "highs": "1.15.3"
  }
}
